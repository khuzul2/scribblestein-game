[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="world_cracked"
2d_physics/layer_3="climbable"
2d_physics/layer_4="player_body"
2d_physics/layer_5="enemy_body"
2d_physics/layer_6="player_hurtbox"
2d_physics/layer_7="enemy_hurtbox"
2d_physics/layer_8="player_damage"
2d_physics/layer_9="enemy_damage"
2d_physics/layer_10="pickup"
2d_physics/layer_11="hazard"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.956863, 0.941176, 0.901961, 1)
2d/snap/snap_2d_transforms_to_pixel=false
2d/snap/snap_2d_vertices_to_pixel=false
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/screen_space_aa=0
